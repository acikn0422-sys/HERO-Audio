{
  "schema_version": 4,
  "audio": {
    "sample_rate_hz": 48000,
    "channels": 1,
    "sample_format": "float32"
  },
  "analysis": {
    "frame_size_samples": 1024,
    "hop_size_samples": 256,
    "window": "hann",
    "threshold_mode": "causal",
    "threshold_history_frames": 16,
    "threshold_stddev_multiplier": 1.5,
    "threshold_offset": 0.0,
    "minimum_flux": 0.0,
    "peak_confirmation_lookahead_frames": 1,
    "refractory_ms": 30.0
  },
  "evaluation": {
    "matching_tolerance_ms": 50,
    "matching_objective": "max_cardinality_then_min_total_absolute_error"
  },
  "benchmark": {
    "warmup_runs": 3,
    "measured_runs": 5,
    "include_plan_creation_in_steady_state": false,
    "whole_file_metric": "wav_read_to_onset_csv_serialized",
    "whole_file_output_sink": "in_memory",
    "percentile_method": "linear_type_7",
    "report_percentiles": [50, 95, 99],
    "streaming": {
      "input_hop_samples": 256,
      "warmup_passes": 1,
      "measured_passes": 5,
      "metric": "steady_state_hop_compute",
      "timed_scope": "hop_insert_hann_fft_flux_causal_detection",
      "excluded_scope": "wav_decode_backend_initialization_audio_device_driver",
      "startup_fill_hops_excluded": true,
      "partial_tail_policy": "ignore_without_padding",
      "deadline_ms_at_48000_hz": 5.333333333,
      "requirement": "p95_strictly_less_than_hop_period"
    },
    "live_coreaudio": {
      "platform": "macos",
      "input_device_policy": "current_default_input",
      "sample_rate_policy": "device_native_integer_rate",
      "client_format": "mono_float32",
      "callback_work": "render_aggregate_enqueue_only",
      "queue_type": "bounded_lock_free_spsc",
      "queue_capacity_hops": 64,
      "queue_overflow_policy": "drop_hop_count_gap_reset_processor",
      "recording_format": "mono_pcm16_wav",
      "capture_integrity_requirement": "zero_dropped_hops_and_zero_render_errors",
      "device_and_driver_latency_included": false,
      "transient_anomaly_layer": {
        "config": "configs/transient_anomaly_v1.json",
        "default_operating_state": "steady",
        "baseline_seconds": 30.0,
        "core_hop_compute_metric_unchanged": true
      }
    }
  }
}
